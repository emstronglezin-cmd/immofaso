# ---- Base ----
PORT=3000
NODE_ENV=development
PUBLIC_URL=http://localhost:3000

# ---- PostgreSQL ----
# Requise pour le fonctionnement du backend.
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/immofaso?schema=public

# ---- Auth (JWT) ----
# Requises. En production, utilisez des valeurs longues et aléatoires.
JWT_SECRET=change-me-in-production
JWT_REFRESH_SECRET=change-me-refresh-in-production
JWT_EXPIRES_IN=1d
JWT_REFRESH_EXPIRES_IN=7d

# ---- CORS ----
# Origines autorisées, séparées par des virgules (ex: https://immofaso.vercel.app)
CORS_ORIGINS=http://localhost:5173,http://localhost:8080

# ---- Stockage ----
# local = disque local (uploads/). Prêt pour un stockage externe plus tard.
STORAGE_DRIVER=local
UPLOADS_DIR=uploads

# ---- LeekPay (OPTIONNEL) ----
# LEEKPAY_ENABLED=false => le backend démarre sans credentials LeekPay.
# pk_live_xxx = clé publique, sk_live_xxx = clé secrète.
LEEKPAY_ENABLED=false
LEEKPAY_PUBLIC_KEY=
LEEKPAY_SECRET_KEY=
LEEKPAY_API_URL=https://leekpay.fr/api/v1

# ---- WhatsApp OTP (OPTIONNEL) ----
# WHATSAPP_ENABLED=false => le backend démarre sans credentials WhatsApp OTP.
WHATSAPP_ENABLED=false
WHATSAPP_API_KEY=
WHATSAPP_AUTH_KEY=
WHATSAPP_API_URL=https://api-whatsappotp.total-innovation.net/v1/otp/send