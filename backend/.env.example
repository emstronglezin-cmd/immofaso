# ---- Base ----
PORT=3000
NODE_ENV=development
PUBLIC_URL=http://localhost:3000

# ---- PostgreSQL ----
# Requise pour le fonctionnement du backend.
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/immofaso?schema=public

# ---- Auth (JWT) ----
# Requises. En production, utilisez des valeurs longues et aléatoires.
JWT_SECRET=change-me-in-production
JWT_REFRESH_SECRET=change-me-refresh-in-production
JWT_EXPIRES_IN=1d
JWT_REFRESH_EXPIRES_IN=7d

# ---- CORS ----
# Origines autorisées, séparées par des virgules (ex: https://immofaso.vercel.app)
CORS_ORIGINS=http://localhost:5173,http://localhost:8080

# ---- Stockage ----
# local = disque local (uploads/). Prêt pour un stockage externe plus tard.
STORAGE_DRIVER=local
UPLOADS_DIR=uploads

# ---- LickPay (OPTIONNEL) ----
# LICKPAY_ENABLED=false => le backend démarre sans credentials LickPay.
LICKPAY_ENABLED=false
LICKPAY_API_KEY=
LICKPAY_API_URL=https://api.lickpay.com

# ---- WhatsApp (OPTIONNEL) ----
# WHATSAPP_ENABLED=false => le backend démarre sans credentials WhatsApp.
WHATSAPP_ENABLED=false
WHATSAPP_API_TOKEN=
WHATSAPP_API_URL=https://graph.facebook.com/v19.0
WHATSAPP_PHONE_ID=